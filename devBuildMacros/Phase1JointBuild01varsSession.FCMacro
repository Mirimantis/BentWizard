App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Housing_Depth', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Housing_Depth = '12.7 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Tenon_Thickness', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Tenon_Thickness = '50.8 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Tenon_Width', 'Joint', '')
