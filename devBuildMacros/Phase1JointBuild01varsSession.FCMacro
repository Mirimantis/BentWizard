App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Tenon_Length', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Tenon_Length = '101.6 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Tenon_Setback_Face1', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Tenon_Setback_Face1 = '0 mm'

FreeCAD.getDocument('Unnamed').getObject('VarSet002').Tenon_Setback_Face1 = '25.4 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Tenon_Setback_Face2', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Tenon_Setback_Face2 = '50.8 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Mortise_Relief', 'Joint', '')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Mortise_Relief = '6.35 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Peg_Diameter', 'Joint', '')
