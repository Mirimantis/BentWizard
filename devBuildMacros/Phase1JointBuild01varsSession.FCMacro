### Begin command Std_VarSet
App.activeDocument().addObject('App::VarSet','VarSet002')
App.ActiveDocument.getObject('VarSet002').ViewObject.doubleClicked()
App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Joint_Station', 'Base', '')
