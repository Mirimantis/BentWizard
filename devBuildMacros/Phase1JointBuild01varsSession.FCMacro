App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Housing_Width', 'Joint', '')
App.getDocument('Unnamed').VarSet002.setExpression('Housing_Width', u'<<TimberDims_B0-1>>.Depth')
App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyLength', 'Housing_Height', 'Joint', '')
App.getDocument('Unnamed').VarSet002.setExpression('Housing_Height', u'<<TimberDims_B0-1>>.Depth')
