FreeCAD.getDocument('Unnamed').getObject('VarSet002').Peg_Drawbore_Offset = '2.38125 mm'

App.getDocument('Unnamed').VarSet002.addProperty('App::PropertyInteger', 'Peg_Count', 'Joint', 'Number of pegs in this joint, for the hardware schedule. Not geometry.')
FreeCAD.getDocument('Unnamed').getObject('VarSet002').Peg_Count = 1

